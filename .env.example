# Copy to .env for local development, or better, set these through Hermes so they
# resolve in gateway sessions, delegated children, and subprocess agent runs:
#
#   hermes env set TABSTACK_API_KEY <your-key>
#
# The plugin reads Hermes' config layer (~/.hermes/.env) first, then the process
# environment.

# Required. Get a key at https://console.tabstack.ai
TABSTACK_API_KEY=

# Optional. Point the SDK at a different API base URL.
# TABSTACK_BASE_URL=https://api.tabstack.ai

# Optional, host debugging. Set to 1 to make Hermes' plugin loader log discovery,
# registration, and load failures to stderr.
# HERMES_PLUGINS_DEBUG=1
